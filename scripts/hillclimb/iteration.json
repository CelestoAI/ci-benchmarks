{
  "iteration": 2,
  "baseline": "unsafe",
  "repeats": 3,
  "classes": [
    "local",
    "network"
  ],
  "note": "Iteration 1 winner `unsafe` (event_idx=off + cache=unsafe) is the new baseline; combine it with the other knobs that helped on either disk class. 3 repeats.",
  "configs": [
    {
      "id": "eidx-off",
      "dev_extra": "event_idx=off",
      "why": "iteration 1 baseline, for reference"
    },
    {
      "id": "unsafe",
      "dev_extra": "event_idx=off",
      "cache": "unsafe",
      "why": "event_idx=off + cache=unsafe"
    },
    {
      "id": "unsafe-iothread",
      "dev_extra": "event_idx=off",
      "cache": "unsafe",
      "iothread": 1
    },
    {
      "id": "unsafe-uring",
      "dev_extra": "event_idx=off",
      "cache": "unsafe",
      "aio": "io_uring"
    },
    {
      "id": "unsafe-iothread-uring",
      "dev_extra": "event_idx=off",
      "cache": "unsafe",
      "iothread": 1,
      "aio": "io_uring"
    },
    {
      "id": "unsafe-cluster-2m",
      "dev_extra": "event_idx=off",
      "cache": "unsafe",
      "qcow2_opts": "cluster_size=2097152"
    },
    {
      "id": "unsafe-reflink-raw",
      "dev_extra": "event_idx=off",
      "cache": "unsafe",
      "layout": "reflink"
    },
    {
      "id": "unsafe-lazy-refcounts",
      "dev_extra": "event_idx=off",
      "cache": "unsafe",
      "qcow2_opts": "lazy_refcounts=on"
    },
    {
      "id": "unsafe-extl2-128k",
      "dev_extra": "event_idx=off",
      "cache": "unsafe",
      "qcow2_opts": "cluster_size=131072,extended_l2=on"
    },
    {
      "id": "unsafe-extl2-prealloc",
      "dev_extra": "event_idx=off",
      "cache": "unsafe",
      "qcow2_opts": "cluster_size=131072,extended_l2=on,preallocation=metadata"
    },
    {
      "id": "unsafe-mmio-modern",
      "dev_extra": "event_idx=off",
      "cache": "unsafe",
      "globals": "virtio-mmio.force-legacy=false"
    }
  ]
