# Shared settings for every Django benchmark setup (GitHub, Celesto runners,
# and warm Celesto computers), so all of them test exactly the same thing.

# Django main on 19 October 2026, pinned so every run tests the same code.
DJANGO_SHA=11af25c0ae06c8275ebb8def8b8ca777a5660ed6
PYTHON_VERSION=3.14
# Number of test shards in the sharded setups (boxd used 8 for Django).
SHARDS=8
# The requirements file the benchmark installs. Django's free-threading list
# drops pylibmc and pywatchman, so no runner has to compile C extensions
# against system libraries (libmemcached), which would differ per image.
REQUIREMENTS=tests/requirements/py3-free-threading.txt

# Setup C: the Celesto custom template (tpl_...) the computers are created from.
TEMPLATE_ID=
